# The runtime contract (PLAN §6). Names only: no secret belongs in git.
# The oldbox container toolkit reads this file when it maps the app.

PORT=                 # listen port, default 8080
BLOG_BASE_URL=        # absolute base for every link, feed and mail; never derived from Host

DB_HOST=              # MariaDB host (the card's db service)
DB_PORT=              # 3306
DB_NAME=              # goblogcfc
DB_USER=              # goblogcfc
DB_PASSWORD=          # secret

ADMIN_PASSWORD=       # seeds the admin user on first start; ignored once a user exists
SESSION_SECRET=       # HMAC key for the session cookie
DATA_DIR=             # uploads root, default /var/lib/go-blogcfc

MAIL_MODE=            # log (default: mail is logged, never sent) | smtp
SMTP_HOST=            # read only when MAIL_MODE=smtp; setting it alone sends nothing
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

TZ=                   # IANA zone, default UTC (the `timezone` setting overrides it for display)

OTEL_EXPORTER_OTLP_ENDPOINT=   # base URL of the collector; unset means no exporter at all
OTEL_EXPORTER_OTLP_PROTOCOL=   # http/protobuf
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL=
